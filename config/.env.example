# ============================================
# 飞书企业自建应用凭证（复制本文件为 .env 后填写）
# 获取位置：飞书开放平台 → 开发者后台 → 你的应用
# 注意：.env 已被 .gitignore 忽略，切勿提交真实密钥
# ============================================

# 应用凭证
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 多维表格 app_token：打开多维表格，URL 中 /base/ 后面那段
FEISHU_APP_TOKEN=bascnxxxxxxxxxxxxxxxx

# 任务表 table_id：打开任务表后 URL 中 table= 后面那段（M1 只需要任务表）
FEISHU_TASK_TABLE_ID=tblxxxxxxxxxxxxxx

# 以下表 M1 暂不使用，后续阶段再填
# FEISHU_SUBTASK_TABLE_ID=
# FEISHU_GOAL_TABLE_ID=
# FEISHU_REVIEW_TABLE_ID=
# FEISHU_DISTRACTION_TABLE_ID=
# FEISHU_SETTINGS_TABLE_ID=

# ============================================
# 飞书企业自建应用凭证（复制本文件为 .env 后填写）
# 获取位置：飞书开放平台 → 开发者后台 → 你的应用
# 注意：.env 已被 .gitignore 忽略，切勿提交真实密钥
# ============================================

# 应用凭证
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 多维表格 app_token：打开多维表格，URL 中 /base/ 后面那段
FEISHU_APP_TOKEN=bascnxxxxxxxxxxxxxxxx

# 任务表 table_id：打开任务表后 URL 中 table= 后面那段（M1 只需要任务表）
FEISHU_TASK_TABLE_ID=tblxxxxxxxxxxxxxx

# 子任务表 table_id（M3 起使用：客户端详情展示子任务，不填则不展示）
# FEISHU_SUBTASK_TABLE_ID=tblxxxxxxxxxxxxxx
# 以下表后续阶段再填
# FEISHU_GOAL_TABLE_ID=
# FEISHU_REVIEW_TABLE_ID=
# 娱乐监控日志表 table_id（M4 起使用：聚合写入娱乐会话日志，不填则仅本地缓存不入飞书）
# FEISHU_MONITOR_LOG_TABLE_ID=tblxxxxxxxxxxxxxx
# FEISHU_SETTINGS_TABLE_ID=

# ============================================
# DeepSeek AI（M3：一句话建任务 / AI 拆解）
# 获取位置：https://platform.deepseek.com → API Keys
# 不填则客户端 AI 功能置灰，其余功能不受影响
# ============================================
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 以下两项一般无需修改
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

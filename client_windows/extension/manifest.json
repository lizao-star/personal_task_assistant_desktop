{
  "manifest_version": 3,
  "name": "个人任务助理监督扩展",
  "version": "1.0.0",
  "description": "向本地客户端上报当前活跃标签的域名/标题/停留时长，并接收关闭娱乐标签的指令。仅与 127.0.0.1 通信。",
  "permissions": ["tabs", "scripting", "storage"],
  "host_permissions": [
    "http://127.0.0.1:8765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
